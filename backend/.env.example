# === LLM PROVIDERS (Provide either or both) ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai     # "openai", "anthropic", or "auto"

ANTHROPIC_API_KEY=sk-ant-...

# === WEBCMD ===
# "real" uses the local @agentrhq/webcmd CLI for live browser automation
# "mock" uses simulated canned data
WEBCMD_MODE=real

# === LLM COST CONTROLS ===
# Model to use for planner/matcher (default: claude-haiku-4-5-20250901)
LLM_MODEL=claude-haiku-4-5-20250901
# LLM_MODEL=claude-sonnet-4-20250514   # uncomment to switch to Sonnet

# === APPROVAL GATE ===
# Seconds to wait for human approval before auto-rejecting (default: 300)
APPROVAL_TIMEOUT_SECONDS=300
# Set to "true" for live demos — auto-approves after 10s
APPROVAL_DEMO_MODE=false

# === WEBCMD TIMEOUTS ===
WEBCMD_EXPLORE_TIMEOUT=60
WEBCMD_EXECUTE_TIMEOUT=30

# === DATABASE ===
DATABASE_URL=sqlite+aiosqlite:///./scout.db
